rules_version = '2';

// Reglas de acceso de Riders (design.md de rider-onboarding, D4; design.md de roadmap-planning,
// D4). Se prueban en src/backend/firebase/firestore-rules.emulator.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(riderId) {
      return isSignedIn() && request.auth.uid == riderId;
    }

    function isTextBetween(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isValidAvatar(avatar) {
      return avatar is map
        && avatar.keys().hasOnly(['helmetType', 'helmetColor', 'neckwear', 'neckwearColor', 'glasses', 'beard'])
        && avatar.helmetType in ['full-face', 'modular']
        && avatar.helmetColor in ['white', 'black', 'gray']
        && avatar.neckwear in ['bandana', 'buff', 'tube', 'checkered-flag']
        && avatar.neckwearColor in ['blue', 'green', 'red', 'orange', 'yellow', 'light-blue']
        && avatar.glasses is bool
        && avatar.beard is bool;
    }

    function isValidRider(rider) {
      return rider.keys().hasOnly(['displayName', 'avatar', 'createdAt', 'updatedAt'])
        && isTextBetween(rider.displayName, 2, 24)
        && isValidAvatar(rider.avatar)
        && rider.createdAt is timestamp
        && rider.updatedAt == request.time;
    }

    // Un Roadmap en planificación: los campos que escribe la app, con sus rangos (roadmap-planning, D4).
    // Las reglas no recorren listas: la forma de cada Point y de cada tramo la valida la app.
    function isValidRoadmap(roadmap) {
      return roadmap.keys().hasOnly(['ownerId', 'name', 'description', 'status', 'points', 'legs',
          'totalDistanceM', 'totalDurationS', 'createdAt', 'updatedAt'])
        && roadmap.ownerId is string
        && isTextBetween(roadmap.name, 2, 60)
        && roadmap.description is string
        && roadmap.description.size() <= 500
        && roadmap.status == 'planning'
        && roadmap.points is list
        && roadmap.points.size() >= 2
        && roadmap.points.size() <= 50
        && roadmap.legs is list
        && roadmap.legs.size() == roadmap.points.size() - 1
        && roadmap.totalDistanceM is number
        && roadmap.totalDurationS is number
        && roadmap.createdAt is timestamp
        && roadmap.updatedAt == request.time;
    }

    function isValidVehicle(vehicle) {
      return vehicle.keys().hasOnly(['model', 'rangeKm', 'updatedAt'])
        && isTextBetween(vehicle.model, 2, 40)
        && vehicle.rangeKm is int
        && vehicle.rangeKm >= 50
        && vehicle.rangeKm <= 1000
        && vehicle.updatedAt == request.time;
    }

    // Perfil público: nombre visible y avatar, legibles por cualquier Rider identificado.
    match /riders/{riderId} {
      allow read: if isSignedIn();
      allow create: if isOwner(riderId)
        && isValidRider(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(riderId)
        && isValidRider(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(riderId);

      // El Vehicle es privado: solo su dueño lo lee y lo escribe.
      match /private/vehicle {
        allow read, delete: if isOwner(riderId);
        allow create, update: if isOwner(riderId) && isValidVehicle(request.resource.data);
      }
    }

    // Roadmaps: en planificación los lee y escribe solo su autor; roadmap-convening agrega miembros.
    match /roadmaps/{roadmapId} {
      allow read, delete: if resource != null && isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId)
        && isValidRoadmap(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data.ownerId)
        && isValidRoadmap(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
